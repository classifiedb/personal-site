---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing" description="Notes and articles on security engineering and AI security.">
  <p class="eyebrow">~/writing</p>
  <h1>Writing</h1>
  <p class="lead">Notes on security engineering, AI security, and things I've built.</p>
  {posts.length === 0 ? (
    <p class="muted">First posts coming soon.</p>
  ) : (
    <ul class="card-list">
      {posts.map((post) => (
        <li class="card">
          <span class="meta">
            {post.data.date.toISOString().slice(0, 10)}{post.data.draft && ' · draft'}
          </span>
          <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
