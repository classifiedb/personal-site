---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Security and systems projects by Benson Jengela.">
  <p class="eyebrow">~/projects</p>
  <h1>Projects</h1>
  <p class="lead">Security, systems, and AI projects I've designed and built.</p>
  <ul class="card-list">
    {projects.map((p) => (
      <li class="card">
        <span class="meta">{p.data.year}</span>
        <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.summary}</p>
        <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
      </li>
    ))}
  </ul>
</Base>
